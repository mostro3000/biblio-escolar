# Configuración de la biblioteca escolar.
# El instalador (install.sh / biblio-setup) genera el .env real con valores seguros;
# este archivo es solo de referencia. NO pongas secretos reales acá.

# --- Identidad de la escuela (configurable) ---
# Nombre que se muestra en la portada, el título y las etiquetas. Se aplica al front con
# `biblio-rebrand` (el instalador lo hace solo). El logo se cambia con `--logo` o reemplazando
# /var/www/html/biblio/logo.jpg (y favicon.png / icon-192.png / icon-512.png).
BIBLIO_NOMBRE=Biblioteca Escolar

# --- Base de datos PostgreSQL (obligatorio) ---
# El instalador crea el rol/base y completa la contraseña automáticamente.
DATABASE_URL=postgresql+psycopg://biblio:CAMBIAR_PASSWORD@localhost:5432/biblio

# --- Credencial QR rotativa del alumno ---
# Segundos por ventana del código (recomendado 30-60).
QR_STEP_SECONDS=30

# --- Lectura de tapa con IA (OPCIONAL) ---
# Clave de Anthropic (Claude) para leer título/autor de la foto de la tapa cuando el
# ISBN no aparece online. Sin esto, esa función queda deshabilitada (el resto anda igual).
ANTHROPIC_API_KEY=
COVER_AI_MODEL=claude-haiku-4-5

# --- Lookup de ISBN online (OPCIONAL) ---
# Clave de Google Books (gratis, console.cloud.google.com). Sin esto usa Open Library;
# Google puede devolver 429 por cuota sin clave.
GOOGLE_BOOKS_API_KEY=

# --- Avisos de vencimiento por Web Push ---
# El instalador genera las claves VAPID. La pública va al navegador; la privada (archivo
# PEM) firma los envíos. Si quedan vacías, el push queda deshabilitado.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_FILE=/opt/biblio/vapid_private.pem
VAPID_SUBJECT=mailto:admin@example.org
