[Unit]
Description=Backup de la base PostgreSQL de biblio (pg_dump)
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=biblio
Group=biblio
ExecStart=/opt/biblio/scripts/backup.sh
# Endurecimiento: el backup no necesita casi nada del sistema.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/biblio/backups
ProtectHome=true
PrivateTmp=true
